# Environment & Server
ENV=development
DEBUG=True
PORT=8000
TIMEZONE=Asia/Kolkata
SECRET_KEY=cricket-super-secret-production-key-change-in-env-2027
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./cricket_league.db
# Supabase PostgreSQL connection string for production:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Supabase Storage (Private bucket for payment screenshots)
# Leave empty for local disk storage during development/testing
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=payment-proofs

# Initial Admin Credentials (Seeded on first startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@cricketleague.com
INITIAL_ADMIN_PASSWORD=CricketAdmin@2027
INITIAL_ADMIN_NAME=League Administrator
